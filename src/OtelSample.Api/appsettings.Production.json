{
  // Production overrides — ECS / Fargate with ADOT Collector sidecar.
  // The ADOT Collector receives OTLP on localhost:4317 and forwards to:
  //   • AWS X-Ray (traces)
  //   • Amazon Managed Prometheus / AMP (metrics)
  //   • Amazon CloudWatch (logs via OTel log exporter)
  "Otel": {
    "Mode": "aws",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  }
}
