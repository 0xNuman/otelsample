{
  // Development overrides — local docker-compose stack.
  // Otel:Mode = "local" (inherited from appsettings.json) enables:
  //   • /metrics Prometheus scrape endpoint
  //   • Console trace exporter (spans visible in terminal)
  "Otel": {
    "SlowQueryThresholdMs": 100
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "System.Net.Http": "Information"
      }
    }
  }
}
